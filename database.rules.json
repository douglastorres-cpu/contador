{
  "rules": {
    ".read": false,
    ".write": false,
    "equipos": {
      ".read": true,
      "$modulo": {
        ".validate": "$modulo.matches(/^(sistemas|comercial|marketing|captacion|ventas|alquiler)$/)",
        "personas": {
          "$id": {
            ".write": true,
            ".validate": "newData.hasChildren(['nombre', 'count'])",
            "nombre": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40"
            },
            "count": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
            },
            "last": {
              ".validate": "newData.isNumber()"
            },
            "creado": {
              ".validate": "newData.isNumber()"
            },
            "$otro": {
              ".validate": false
            }
          }
        },
        "$otro": {
          ".validate": false
        }
      }
    }
  }
}
